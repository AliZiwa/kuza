@@ -0,0 +1,93 @@
+package com.kuza.app.domain
+
+/**
+ * Week 3: the third seam, and the first one that reads the whole table. A [Replier] speaks for
+ * the friend, a [Suggester] offers words to you, a [Summarizer] tells you what the thread was
+ * about. It is the first seam filled by a language model, and the screen still never learns that.
+ */
+fun interface Summarizer {
+    suspend fun summarize(transcript: List<Message>): Summary
+}
+
+/**
+ * Every answer a summarizer can give, as a closed set. The screen renders each one and nothing
+ * else. A model may fail in a hundred ways; the user gets to see five.
+ */
+sealed interface Summary {
+    /** One to three short lines, already stripped of the model's bullet markers. */
+    data class Bullets(val lines: List<String>) : Summary
+
+    /** Fewer messages than [SummaryRules.MIN_MESSAGES]. Nothing to summarize yet. */
+    data object TooShort : Summary
+
+    /** AICore says the feature is unavailable on this device. The button should not pretend. */
+    data object NotOnThisPhone : Summary
+
+    /** The model is being fetched. Ask again when it lands. [bytes] is what AICore reported. */
+    data class Downloading(val bytes: Long) : Summary
+
+    /** The model exists here and still said no. [reason] is the error code name, for the log. */
+    data class Failed(val reason: String) : Summary
+}
+
+/** Week 1 and 2 behaviour, kept as a value: the button is never shown. */
+object NoSummary : Summarizer {
+    override suspend fun summarize(transcript: List<Message>): Summary = Summary.NotOnThisPhone
+}
+
+/** How many bullets we ask for. A closed enum, mapped to the SDK constant at the edge. */
+enum class SummaryLength(val bullets: Int) { ONE(1), TWO(2), THREE(3) }
+
+/**
+ * The rules around the model, pure and tested without a device. [conversation] decides what the
+ * model may read; [parse] decides what the screen may show. The model sits between the two gates.
+ */
+object SummaryRules {
+    /** Below this a summary is a reprint. Four lines is the smallest thread with a shape. */
+    const val MIN_MESSAGES = 4
+
+    /**
+     * ML Kit GenAI Summarization accepts under 4000 tokens, about 3000 English words. We budget
+     * by characters, newest lines first, and stay well inside: 12000 characters is roughly 3000
+     * tokens of chat, where lines are short and tokens are cheap.
+     */
+    const val MAX_CHARS = 12_000
+
+    /** The names the model reads. InputType.CONVERSATION wants `<name>: <message>`, one per line. */
+    fun name(author: Author): String = when (author) {
+        Author.You -> "You"
+        Author.Friend -> "Friend"
+    }
+
+    /**
+     * The transcript as the model wants it, or null when there is not enough to summarize.
+     * Trimming happens from the head, not the tail: the SDK's auto truncation keeps the prefix,
+     * and the prefix of a chat is "hi". A summary should favour what was said last.
+     */
+    fun conversation(transcript: List<Message>): String? {
+        if (transcript.size < MIN_MESSAGES) return null
+        val lines = transcript.map { "${name(it.author)}: ${it.text.replace('\n', ' ').trim()}" }
+        var budget = MAX_CHARS
+        val kept = ArrayList<String>(lines.size)
+        for (line in lines.asReversed()) {
+            budget -= line.length + 1
+            if (budget < 0) break
+            kept += line
+        }
+        if (kept.size < MIN_MESSAGES) return null
+        return kept.asReversed().joinToString("\n")
+    }
+
+    /**
+     * The model answers in Markdown-ish bullets, one per line, each starting with "* ". We strip
+     * the markers, drop blanks, and never show more lines than we asked for, whatever came back.
+     */
+    fun parse(raw: String, length: SummaryLength): Summary {
+        val lines = raw.lineSequence()
+            .map { it.trim().trimStart('*', '-', '•').trim() }
+            .filter { it.isNotEmpty() }
+            .take(length.bullets)
+            .toList()
+        return if (lines.isEmpty()) Summary.Failed("EMPTY_RESPONSE") else Summary.Bullets(lines)
+    }
+}
