+                )
+                is Summary.Failed -> Text("The model declined: ${summary.reason}.")
+            }
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.End) {
+                TextButton(onClick = onDismiss) { Text("Dismiss") }
