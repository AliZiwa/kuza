@@ -0,0 +1,63 @@
+package com.kuza.app.domain
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** Week 3: the two gates around Gemini Nano, tested without a phone that has it. */
+class SummaryRulesTest {
+
+    private fun thread(vararg lines: String): List<Message> =
+        lines.mapIndexed { i, text ->
+            Message(id = i + 1L, author = if (i % 2 == 0) Author.You else Author.Friend, text = text, sentAt = i.toLong())
+        }
+
+    @Test
+    fun `too few messages is nothing to summarize`() {
+        assertNull(SummaryRules.conversation(thread("hi", "hello", "how far?")))
+    }
+
+    @Test
+    fun `the model reads name colon message, one per line, oldest first`() {
+        val text = SummaryRules.conversation(thread("hi", "hello", "lunch?", "yes, jollof"))
+        assertEquals("You: hi\nFriend: hello\nYou: lunch?\nFriend: yes, jollof", text)
+    }
+
+    @Test
+    fun `newlines inside a message are flattened so lines stay lines`() {
+        val text = SummaryRules.conversation(thread("one\ntwo", "a", "b", "c"))
+        assertEquals("You: one two", text!!.lineSequence().first())
+    }
+
+    @Test
+    fun `a long thread is trimmed from the head, never the tail`() {
+        val filler = "x".repeat(1_000)
+        val lines = List(20) { filler } + listOf("the last word")
+        val text = SummaryRules.conversation(thread(*lines.toTypedArray()))!!
+        assertTrue(text.length <= SummaryRules.MAX_CHARS)
+        assertTrue(text.endsWith("the last word"))
+        assertTrue(text.lineSequence().count() < lines.size)
+    }
+
+    @Test
+    fun `bullets lose their markers and never exceed what was asked for`() {
+        val raw = "* Lunch was agreed.\n* Jollof, not fried rice.\n* Friend pays.\n* A fourth line we did not ask for."
+        val summary = SummaryRules.parse(raw, SummaryLength.THREE)
+        assertEquals(
+            Summary.Bullets(listOf("Lunch was agreed.", "Jollof, not fried rice.", "Friend pays.")),
+            summary,
+        )
+    }
+
+    @Test
+    fun `one bullet requested means one bullet shown`() {
+        val summary = SummaryRules.parse("- first\n- second", SummaryLength.ONE)
+        assertEquals(Summary.Bullets(listOf("first")), summary)
+    }
+
+    @Test
+    fun `an empty answer is a failure with a name, not an empty card`() {
+        assertEquals(Summary.Failed("EMPTY_RESPONSE"), SummaryRules.parse("* \n\n", SummaryLength.TWO))
+    }
+}
