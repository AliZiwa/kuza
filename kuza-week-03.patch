+package com.kuza.app.ml
+
+import android.content.Context
+import com.google.mlkit.genai.common.DownloadCallback
+import com.google.mlkit.genai.common.FeatureStatus
+import com.google.mlkit.genai.common.GenAiException
+import com.google.mlkit.genai.summarization.Summarization
+import com.google.mlkit.genai.summarization.SummarizationRequest
+import com.google.mlkit.genai.summarization.SummarizerOptions
+import com.google.mlkit.genai.summarization.Summarizer as NanoSummarizer
+import com.kuza.app.domain.Message
+import com.kuza.app.domain.Summary
+import com.kuza.app.domain.SummaryLength
+import com.kuza.app.domain.SummaryRules
+import com.kuza.app.domain.Summarizer
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.guava.await
+
+/**
+ * Week 3: ML Kit GenAI Summarization behind the [Summarizer] seam. The first language model in
+ * the app, and the first model the app does not own. Gemini Nano lives in AICore, an Android
+ * system service, and is shared by every app on the phone. We ask it to read the thread as a
+ * conversation and hand back up to three bullets.
+ *
+ * Artifact: com.google.mlkit:genai-summarization:1.0.0-beta1 (beta, no SLA). English, Japanese,
+ * and Korean. Supported phones only (Pixel 9 and newer, Galaxy S25 and newer, and a list of
+ * others); everywhere else [checkFeatureStatus] says UNAVAILABLE and we say [Summary.NotOnThisPhone].
+ *
+ * House rules that are not ours: inference only while the app is in the foreground, a per-app
+ * inference quota (BUSY), and a per-app daily battery quota. The landlord keeps the meter.
+ */
+class GeminiNanoSummarizer(
+    context: Context,
+    private val length: SummaryLength = SummaryLength.THREE,
+) : Summarizer, AutoCloseable {
+
+    private val client: NanoSummarizer = Summarization.getClient(
+        SummarizerOptions.builder(context)
+            .setInputType(SummarizerOptions.InputType.CONVERSATION)
+            .setOutputType(outputType(length))
+            .setLanguage(SummarizerOptions.Language.ENGLISH)
+            // Off on purpose: the SDK keeps the prefix, and SummaryRules already kept the tail.
+            .setLongInputAutoTruncationEnabled(false)
+            .build(),
+    )
+
+    override suspend fun summarize(transcript: List<Message>): Summary {
+        val text = SummaryRules.conversation(transcript) ?: return Summary.TooShort
+
+        return try {
+            when (client.checkFeatureStatus().await()) {
+                FeatureStatus.UNAVAILABLE -> return Summary.NotOnThisPhone
+                FeatureStatus.DOWNLOADABLE -> {
+                    // One-time fetch of the feature. AICore tells us the size; the docs do not.
+                    var bytes = 0L
+                    client.downloadFeature(object : DownloadCallback {
+                        override fun onDownloadStarted(bytesToDownload: Long) { bytes = bytesToDownload }
+                        override fun onDownloadProgress(totalBytesDownloaded: Long) = Unit
+                        override fun onDownloadCompleted() = Unit
+                        override fun onDownloadFailed(e: GenAiException) = Unit
+                    }).await()
+                    return Summary.Downloading(bytes)
+                }
+                FeatureStatus.DOWNLOADING -> return Summary.Downloading(bytes = -1)
+                else -> Unit // AVAILABLE
+            }
+            val result = client.runInference(SummarizationRequest.builder(text).build()).await()
+            SummaryRules.parse(result.summary, length)
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: GenAiException) {
+            when (e.errorCode) {
+                GenAiException.ErrorCode.REQUEST_TOO_SMALL -> Summary.TooShort
+                GenAiException.ErrorCode.NOT_AVAILABLE,
+                GenAiException.ErrorCode.AICORE_INCOMPATIBLE,
+                GenAiException.ErrorCode.NEEDS_SYSTEM_UPDATE -> Summary.NotOnThisPhone
+                else -> Summary.Failed(reasonName(e.errorCode))
+            }
+        } catch (e: Exception) {
+            Summary.Failed(e.javaClass.simpleName)
+        }
+    }
+
+    /** Releases the engine. The ViewModel calls this from onCleared. */
+    override fun close() = client.close()
+
+    private companion object {
+        /** The closed enum meets the SDK's int constants here and nowhere else. */
+        fun outputType(length: SummaryLength): Int = when (length) {
+            SummaryLength.ONE -> SummarizerOptions.OutputType.ONE_BULLET
+            SummaryLength.TWO -> SummarizerOptions.OutputType.TWO_BULLETS
+            SummaryLength.THREE -> SummarizerOptions.OutputType.THREE_BULLETS
+        }
+
+        /** The codes the article cares about, by name. Anything else is reported by number. */
+        fun reasonName(code: Int): String = when (code) {
+            GenAiException.ErrorCode.BUSY -> "BUSY"
+            GenAiException.ErrorCode.BACKGROUND_USE_BLOCKED -> "BACKGROUND_USE_BLOCKED"
+            GenAiException.ErrorCode.PER_APP_BATTERY_USE_QUOTA_EXCEEDED -> "BATTERY_QUOTA"
+            GenAiException.ErrorCode.REQUEST_TOO_LARGE -> "REQUEST_TOO_LARGE"
+            GenAiException.ErrorCode.NOT_ENOUGH_DISK_SPACE -> "NOT_ENOUGH_DISK_SPACE"
+            GenAiException.ErrorCode.RESPONSE_PROCESSING_ERROR,
+            GenAiException.ErrorCode.RESPONSE_GENERATION_ERROR,
+            GenAiException.ErrorCode.REQUEST_PROCESSING_ERROR -> "POLICY"
+            else -> "GENAI_$code"
+        }
+    }
+}
